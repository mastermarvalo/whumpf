# -----------------------------------------------------------------------------
# Whumpf — environment template
#
# Copy to .env and fill in real values.  Never commit .env.
#
# Prod setup
# ----------
# Set ALL values before running `make up` for the first time. The Postgres
# and MinIO volumes initialize from these on first start — changing them
# afterwards requires either nuking volumes or manual intervention inside
# the containers (ALTER ROLE in psql, mc admin user in MinIO).
#
# Generate secrets:
#   JWT_SECRET          →  openssl rand -hex 32
#   POSTGRES_PASSWORD   →  openssl rand -base64 24
#   MINIO_ROOT_PASSWORD →  openssl rand -base64 18   (must be ≥ 8 chars)
#   REDIS_PASSWORD      →  openssl rand -hex 32      (hex only: it goes into a URL)
#   STRAVA_TOKEN_KEY    →  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------

# --- PostGIS ----------------------------------------------------------------
# POSTGRES_USER / POSTGRES_DB — pick a name (e.g. whumpf). Set once, never
# change without nuking the volume or running ALTER ROLE / ALTER DATABASE.
POSTGRES_DB=whumpf
POSTGRES_USER=whumpf
POSTGRES_PASSWORD=change-me                    # openssl rand -base64 24

# --- MinIO ------------------------------------------------------------------
# MINIO_ROOT_USER: min 3 chars. MINIO_ROOT_PASSWORD: min 8 chars.
# Same first-run rule applies — set before `make up`, or nuke the volume to
# change.
MINIO_ROOT_USER=whumpfadmin
MINIO_ROOT_PASSWORD=change-me                  # openssl rand -base64 18

# --- Redis ------------------------------------------------------------------
# Redis listens on 127.0.0.1 only and requires this password. compose.yml
# builds the api's REDIS_URL from it, so there is no separate REDIS_URL. Use
# hex (no @ : / characters), since it is embedded in redis://:<password>@host.
REDIS_PASSWORD=change-me                       # openssl rand -hex 32

# --- FastAPI / JWT ----------------------------------------------------------
WHUMPF_ENV=dev                                 # set to "prod" in production
JWT_SECRET=run-openssl-rand-hex-32-here        # openssl rand -hex 32
# Days a refresh token (from /auth/token, /auth/refresh) stays valid. Each
# refresh issues a new one, so active users stay signed in indefinitely.
REFRESH_TOKEN_TTL_DAYS=60

# --- Tiles --------------------------------------------------------------------
# Allow /tiles/* requests without a ?t= tile token (from POST /tiles/token),
# under a strict per-IP limit. Keep true while the old website, which sends no
# tokens, is still live; set false once it is gone (then purge /tiles/* in
# Cloudflare, or cached tokenless URLs keep being served).
TILES_ALLOW_TOKENLESS=true

# --- NOAA NOHRSC snowfall (make snowfall-refresh, hourly cron) --------------
# User-Agent for the hourly NOHRSC downloads (default below). NOAA states no
# policy; a contact address lets them reach you instead of blocking. Optional.
# Keep the quotes: scripts/backup.sh sources this file with sh.
# NOHRSC_USER_AGENT="whumpf/0.1 (+https://whumpf.co; you@example.com)"

# --- NOAA weather layers + spot forecast (docs/runbook.md §9) ---------------
# User-Agent for the snow depth, temperature and radar jobs and for
# api.weather.gov (spot forecast). api.weather.gov requires one and asks for
# contact details so they can reach you instead of blocking. Set it in prod.
# WEATHER_USER_AGENT="whumpf/0.1 (+https://whumpf.co; you@example.com)"

# --- Mountain cameras (docs/runbook.md §10) ----------------------------------
# Free API keys. Leave one empty and that source is left out of the layer.
# Never commit them; they are sent as headers only and never logged.
# Windy Webcams API (free tier): https://api.windy.com/keys
WINDY_WEBCAMS_API_KEY=
# NPS API (webcams near Rocky Mountain NP): https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# --- Road conditions (docs/runbook.md §11) -----------------------------------
# CDOT COtrip data feed key: request at https://manage-api.cotrip.org (accept
# the terms; a CDOT admin approves it). Empty turns the Road conditions layer
# off (use that if CDOT revokes access). COtrip takes it in the URL, so the
# jobs never log URLs and redact it from every log line. Never commit it.
COTRIP_API_KEY=

# --- CORS / frontend wiring -------------------------------------------------
# Local dev — Vite on :5173, all services on localhost.
# Prod — replace with your actual domain(s). CORS_ALLOW_ORIGINS accepts a
# comma-separated list if you need multiple origins.
CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_MARTIN_URL=http://localhost:3000
VITE_TITILER_URL=http://localhost:8001
# "prod" (nginx + minified bundle) or "dev" (Vite dev server with HMR).
# Defaults to prod. Switch to dev locally if you want hot-reload.
FRONTEND_TARGET=prod

# --- Observability (frontend, baked at build time) ----------------------------
# Sentry: sign up at https://sentry.io, grab the project DSN, paste here. When
# empty, errors fall through to console.error.
VITE_SENTRY_DSN=
# Plausible: set the domain you configured at https://plausible.io (or your
# self-hosted instance). VITE_PLAUSIBLE_SRC overrides the script URL when
# self-hosting; default is https://plausible.io/js/script.js.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=

# --- Backups (any S3-compatible target — Backblaze B2, AWS S3, …) ------------
# See docs/external-services.md → Backups. Run `make backup` once these are
# set, then schedule via cron. Empty = backup script is a no-op.
BACKUP_S3_ENDPOINT=          # e.g. https://s3.us-west-002.backblazeb2.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Set BACKUP_INCLUDE_COGS=true to also back up dem-cogs (multi-GB). Skip
# unless you regenerate these regularly — the DEM pipeline can rebuild them.
BACKUP_INCLUDE_COGS=false

# --- Strava OAuth (optional) ------------------------------------------------
# Required only if you want Strava activity overlays.
# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to your host (e.g. localhost for dev).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback
STRAVA_SUCCESS_URL=http://localhost:5173
# Encrypts Strava OAuth tokens at rest. Leave empty for dev (legacy plaintext);
# required for prod. Rotate by re-running the openssl/Fernet generator above.
STRAVA_TOKEN_KEY=
# Strava connect may return to whumpf://... or https://whumpf.co/... (the
# client passes ?return_to= to /auth/strava/authorize). true also allows the
# Expo dev targets exp://... and http://localhost:8081/... . Keep false in prod.
STRAVA_RETURN_TO_ALLOW_DEV=false

# --- Account lifecycle / email --------------------------------------------------
# Base URL where users land — used to build verify/reset links inside emails.
APP_BASE_URL=http://localhost:5173
# Mail provider: "console" (logs URLs, useful for dev/staging without SMTP) or
# "resend" (https://resend.com). For prod, sign up for Resend (free tier),
# add a sender domain, set RESEND_API_KEY and switch MAIL_PROVIDER.
MAIL_PROVIDER=console
MAIL_FROM="whumpf <no-reply@whumpf.local>"
RESEND_API_KEY=
# Emails carry 6-digit codes. While true, verify/reset emails also carry the
# old ?verify= / ?reset= links and the API accepts them (the old website uses
# them). Set false once the old website is gone.
LEGACY_EMAIL_LINKS=true

# Comma-separated admin emails (for /status page banner posting, etc.).
# users.is_admin column is the other path; either grants admin.
ADMIN_EMAILS=

# --- Schema migrations ----------------------------------------------------------
# ALLOW_DESTRUCTIVE_DOWNGRADE is deliberately NOT read from this file. Downgrading
# the 0001_baseline migration drops every table, so it refuses on any database
# other than whumpf_test unless passed for one command only:
#   make alembic ARGS="downgrade base" ALLOW_DESTRUCTIVE_DOWNGRADE=1
# Never set it here.
